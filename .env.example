# Required database connection
# Hosted serverless runtime: use the Supabase transaction pooler (port 6543).
# For migrations, supply the session/direct URI to the migration command instead.
DATABASE_URL=postgres://souvenir:souvenir@localhost:5432/souvenir
# Auth and Storage; client receives only these public values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Storage credentials (secret key preferred, legacy service role fallback)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact web origin (required in production); no trailing slash
APP_ORIGIN=http://localhost:3000
# Comma-separated exact Expo web origins; bearer auth only, never wildcard
CORS_ORIGINS=http://localhost:8081
# Provider flags
SEARCH_PROVIDER=pg
AI_PROVIDER=mock
# Destination lookup uses the cached catalog unless explicitly enabled.
PLACES_PROVIDER=osm
PLACES_LAZY_FILL=false
# Use a self-hosted/contracted Overpass instance for production, not public instances.
OVERPASS_URL=
# Acknowledge that this is a self-hosted/contracted endpoint before production use.
OVERPASS_MANAGED_ENDPOINT=false
PLACES_USER_AGENT=Souvenir/0.1 (+https://github.com/garysun1/Souvenir)
# Local fixtures/maintenance only: set to the same loopback URL as DATABASE_URL.
# Leave unset in all deployed environments.
PLACES_DISPOSABLE_DATABASE_URL=
# Optional Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
# Optional OpenAI
OPENAI_API_KEY=
