# Required database connection
DATABASE_URL=postgres://souvenir:souvenir@localhost:5432/souvenir
# Auth and Storage; client receives only these public values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Storage credentials (secret key preferred, legacy service role fallback)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact web origin (required in production); no trailing slash
APP_ORIGIN=http://localhost:3000
# Comma-separated exact Expo web origins; bearer auth only, never wildcard
CORS_ORIGINS=http://localhost:8081
# Provider flags
SEARCH_PROVIDER=pg
AI_PROVIDER=mock
# Optional Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
# Optional OpenAI
OPENAI_API_KEY=
